# ===========================================
# Database (Required)
# ===========================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# ===========================================
# Clerk Authentication (Required)
# Get from: https://dashboard.clerk.com
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/callback

# ===========================================
# OpenRouter - LLM for slide generation (Nemotron 3 Ultra)
# Get from: https://openrouter.ai/settings/keys
# ===========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxx
# Optional: override the model (default: nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ===========================================
# Cloudflare Workers AI - Image generation (FLUX.1 [schnell])
# Get from: https://dash.cloudflare.com (Workers AI)
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ===========================================
# Fallback AI Providers (Optional)
# ===========================================
# Groq AI
GROQ_API_KEY=gsk_xxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Replicate AI
REPLICATE_API_TOKEN=r8_xxxxx

# ===========================================
# Uploadcare - Image uploads (Required)
# Get from: https://app.uploadcare.com
# ===========================================
UPLOADCARE_PUBLIC_KEY=your_uploadcare_public_key
# Same value; the browser upload widget can only read NEXT_PUBLIC_ variables
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your_uploadcare_public_key

# ===========================================
# LemonSqueezy - Payments (Optional)
# Get from: https://app.lemonsqueezy.com
# ===========================================
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMON_SQUEEZY_STORE_ID=your_store_id
LEMON_SQUEEZY_VARIANT_ID=your_variant_id
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_LEMON_SQUEEZY_API=https://api.lemonsqueezy.com/v1

# ===========================================
# App URL (Required)
# ===========================================
NEXT_PUBLIC_HOST_URL=http://localhost:3000
